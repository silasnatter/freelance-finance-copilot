# Copy to .env. Never commit .env.

# Optional override for the DuckDB warehouse path
# FINANCE_COPILOT_WAREHOUSE=data/warehouse.duckdb

# Required only for the optional Docker profile "postgres"
# POSTGRES_PASSWORD=

# Optional: local Ollama endpoint
# OLLAMA_HOST=http://localhost:11434

# Optional: only used after the explicit opt-in in config/settings.yaml
# ANTHROPIC_API_KEY=
